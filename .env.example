# Local JARVIS development settings. Copy to .env or let JARVIS create it.
# true: write config/, memory/, databases/, logs/ and other mutable data
#       inside this source checkout.
# false: write mutable data to the OS user-data directory (AppData on Windows).
# Source development defaults to the repository root for easy inspection.
# Packaged releases ignore .env and always use OS user-data directories.
DEBUG=true
